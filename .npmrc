# --- PROTECCIÓN DE CADENA DE SUMINISTRO ---
# Bloquea comandos maliciosos al momento de instalar dependencias
ignore-scripts = true

# Forzar versiones exactas para evitar fallos por actualizaciones inesperadas de terceros (sin el ^ o ~ en package.json)
save-exact = true

# Requiere que un paquete tenga mínimo 7 días de antiguedad publicado (bloquea secuestros recientes)
minimum-release-age = 10080

# Previene dependencias subyacentes de usar git/tarball URLs para saltarse NPM
block-exotic-subdeps = true

# No confía en versiones de baja reputación o degradaciones maliciosas
trust-policy = no-downgrade

# Usa el motor nativo de permisos de NodeJS para aislar ejecución
node-options = "--permission"
